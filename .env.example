# Tezga API ključ (Podešavanja → Integracije), oblik tzg_ + 48 heks znakova.
# Za probu koristi ključ naloga koji je u sandbox ili simulacija okruženju.
TEZGA_API_KEY=tzg_zalepi_ovde

# Bazni URL API-ja (promeni samo za interni test).
TEZGA_BASE_URL=https://pos.narbiz.com

# Samo za remote (Streamable HTTP) server:
PORT=8787
MCP_PATH=/mcp
